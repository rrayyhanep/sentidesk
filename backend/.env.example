# Authentication and persistence
JWT_SECRET=replace-with-a-long-random-secret
SENTIDESK_DB=./sentidesk.sqlite3
SENTIDESK_DEMO_MODE=true

# Resend email verification (preferred)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_DOMAIN=rrayyhan.work.gd
RESEND_FROM=SentiDesk <onboarding@rrayyhan.work.gd>

# SMTP fallback email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Provider application credentials.
# These configure the integration layer; OAuth redirect URLs and provider
# approval/scopes are still required for live inbox access.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/connections/gmail/oauth/callback
# Optional Gmail sync tuning
GMAIL_SYNC_MAX_RESULTS=25
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/connections/instagram/oauth/callback
INSTAGRAM_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
INSTAGRAM_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# SO Email Security API Integration (dashboard.cloudapi.soemailsecurity.com)
SO_EMAIL_SECURITY_API_KEY=your_cloudapi_key_here
SO_EMAIL_SECURITY_ENDPOINT=https://dashboard.cloudapi.soemailsecurity.com/api/v1/scan

# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
