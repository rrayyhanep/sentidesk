# Authentication and persistence
JWT_SECRET=replace-with-a-long-random-secret
SENTIDESK_DB=./sentidesk.sqlite3
SENTIDESK_DEMO_MODE=true

# Resend email verification (preferred)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_DOMAIN=rrayyhan.work.gd
RESEND_FROM=SentiDesk <onboarding@rrayyhan.work.gd>

# SMTP fallback email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Provider application credentials.
# These configure the integration layer; OAuth redirect URLs and provider
# approval/scopes are still required for live inbox access.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
